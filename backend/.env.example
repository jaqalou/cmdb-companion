# CB Assets Flask backend
# Point these at the same database the web app uses.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Required for CB Assets API tokens (cba_...): the backend validates the token
# and then enforces the owner's role itself. Account bearer tokens do not need it.
SUPABASE_SERVICE_ROLE_KEY=

HOST=127.0.0.1
PORT=5000
